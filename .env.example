# Copy to .env.local for local development. On Vercel: Project → Settings →
# Environment Variables. Never commit real values.
#
# The website needs NO settings to build and serve every page. These two
# connect the consultation form and the chat to the firm app (Matterfold) over
# its lead bridge (docs/website-lead-intake-bridge.md). Until both are set, the
# form answers "Your request could not be submitted. Please call 714-544-1460."
# and no inquiry is taken.

# The app's bridge address, HTTPS: https://<app host>/api/public/leads
MATTERFOLD_INTAKE_ENDPOINT=

# The same long random value as the app's WEBSITE_INTAKE_TOKEN (32+ characters).
# Server-only: never give it a NEXT_PUBLIC_ prefix.
MATTERFOLD_INTAKE_TOKEN=
